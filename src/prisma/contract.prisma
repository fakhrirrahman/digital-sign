enum SignRequestStatus {
  PENDING
  PROCESSING
  SIGNED
  REJECTED
  FAILED
  CANCELLED
}

enum AuditAction {
  SIGN_REQUEST_CREATED
  DOCUMENT_OPENED
  SIGN_ATTEMPT
  SIGNED
  REJECTED
  PIN_FAILED
}

model SignRequest {
  id String @id @default(uuid())

  referenceId  String @unique
  signerUserId String
  villageId    String?

  status SignRequestStatus @default(PENDING)

  rejectionReason String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  signedAt   DateTime?
  rejectedAt DateTime?
}